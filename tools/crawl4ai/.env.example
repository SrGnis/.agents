# Crawl4AI Docker configuration
# https://docs.crawl4ai.com/core/self-hosting/

# Use a specific version tag. E.g. "latest" or "0.9.3".
#CRAWL4AI_VERSION=latest

# Listen to a specific port.
#CRAWL4AI_PORT=11235

# API token for authentication (required for 0.0.0.0 binding)
# Generate one with: openssl rand -hex 32
#CRAWL4AI_API_TOKEN=
